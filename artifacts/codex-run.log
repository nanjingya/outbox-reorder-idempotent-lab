**src/outbox.js**

```js
// 业务库同一事务里先写业务行再写 outbox 事件；这里只负责事件侧的持久化与按追加序读取。
export class OutboxQueue {
  #events = [];

  append(event) {
    const { id, key, version, op, ts, payload } = event ?? {};
    if (!id) throw new Error('outbox event requires id');
    if (!key) throw new Error('outbox event requires key');
    if (typeof version !== 'number') throw new Error('outbox event requires numeric version');
    if (op !== 'upsert' && op !== 'delete') throw new Error(`unknown op: ${op}`);
    const record = { id, key, version, op, ts: ts ?? Date.now(), payload: payload ?? null };
    this.#events.push(record);
    return record;
  }

  get size() {
    return this.#events.length;
  }

  // cursor 是已读位置（追加序下标），返回其后的全部事件，保持追加序。
  listAfter(cursor = 0) {
    return this.#events.slice(cursor);
  }

  // 下一次拉取应传入的 cursor。
  get cursor() {
    return this.#events.length;
  }
}
