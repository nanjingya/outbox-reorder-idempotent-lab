// 按 key 维护已提交版本，窗口内缓冲乱序；超时按到达序投递并标记 late。
export class ReorderBuffer {
  constructor(maxHoldMs = 1000) {
    this.maxHoldMs = maxHoldMs;
    this.committed = new Map(); // key -> 已投递的最高 version
    this.pending = new Map();   // key -> [{ event, arrivedAt }]（到达序）
  }

  offer(event, now = Date.now()) {
    const actions = this.flush(now);
    const key = event.key;
    const committed = this.committed.get(key);

    // 不高于已提交版本的到达都是旧版本（含重复投递），记 stale。
    if (committed !== undefined && event.version <= committed) {
      actions.push({ type: 'stale', event });
      return actions;
    }

    // 该 key 首次出现，或恰好是下一个版本：直接提交，并尝试连排放出缓冲。
    if (committed === undefined || event.version === committed + 1) {
      actions.push({ type: 'emit', event });
      this.committed.set(key, event.version);
      actions.push(...this.#drain(key));
      return actions;
    }

    // 版本跳跃：窗口内缓冲，等乱序补齐。
    const buf = this.pending.get(key) ?? [];
    buf.push({ event, arrivedAt: now });
    this.pending.set(key, buf);
    actions.push({ type: 'hold', event });
    return actions;
  }

  // 把滞留超过 maxHoldMs 的事件按到达序放出，标记 late。
  flush(now = Date.now()) {
    const actions = [];
    for (const [key, buf] of this.pending) {
      const keep = [];
      for (const entry of buf) {
        const committed = this.committed.get(key);
        if (committed !== undefined && entry.event.version <= committed) {
          actions.push({ type: 'stale', event: entry.event });
        } else if (now - entry.arrivedAt >= this.maxHoldMs) {
          this.committed.set(key, entry.event.version);
          actions.push({ type: 'late', event: entry.event });
        } else {
          keep.push(entry);
        }
      }
      if (keep.length) this.pending.set(key, keep);
      else this.pending.delete(key);
    }
    return actions;
  }

  // 提交后把缓冲里连续的下一个版本依次放出；落后于已提交版本的记 stale。
  #drain(key) {
    const actions = [];
    let buf = this.pending.get(key) ?? [];
    const keep = [];
    for (const entry of buf) {
      const committed = this.committed.get(key);
      if (entry.event.version <= committed) {
        actions.push({ type: 'stale', event: entry.event });
      } else {
        keep.push(entry);
      }
    }
    buf = keep;
    let progressed = true;
    while (progressed) {
      progressed = false;
      const next = this.committed.get(key) + 1;
      const idx = buf.findIndex((e) => e.event.version === next);
      if (idx !== -1) {
        const [entry] = buf.splice(idx, 1);
        this.committed.set(key, entry.event.version);
        actions.push({ type: 'emit', event: entry.event });
        progressed = true;
      }
    }
    if (buf.length) this.pending.set(key, buf);
    else this.pending.delete(key);
    return actions;
  }
}
```

**src/idempotentSink.js**

```js
// 下游幂等去重：event.id 只生效一次；按 key 保留最高 version；tombstone 不被旧版本复活。
export class IdempotentSink {
  constructor() {
    this.seen = new Set();        // 已处理过的 event.id
    this.versions = new Map();    // key -> 已生效的最高 version
    this.tombstones = new Map();  // key -> delete 生效时的 version
    this.data = new Map();        // key -> 当前值 { version, payload }
  }

  apply(event) {
    const { id, key, version, op, payload } = event;
    if (this.seen.has(id)) return { applied: false, reason: 'duplicate' };
    this.seen.add(id); // 无论是否生效都记为已见，保证同一 id 只可能生效一次

    const tomb = this.tombstones.get(key);
    if (tomb !== undefined && version < tomb) {
      return { applied: false, reason: op === 'delete' ? 'stale' : 'tombstone' };
    }

    const high = this.versions.get(key);
    if (high !== undefined && version < high) {
      return { applied: false, reason: 'stale' };
    }

    if (op === 'delete') {
      this.tombstones.set(key, version);
      this.data.delete(key);
    } else {
      this.data.set(key, { version, payload: payload ?? null });
    }
    this.versions.set(key, version);
    return { applied: true };
  }

  get(key) {
    return this.data.get(key);
  }
}
```

**src/engine.js**

```js
import { OutboxQueue } from './outbox.js';
import { ReorderBuffer } from './reorderBuffer.js';
import { IdempotentSink } from './idempotentSink.js';

export async function loadEvents(url = 'fixtures/events.jsonl') {
  const res = await fetch(url);
  if (!res.ok) throw new Error(`load ${url} failed: HTTP ${res.status}`);
  const text = await res.text();
  return text
    .split('\n')
    .map((line) => line.trim())
    .filter(Boolean)
    .map((line) => JSON.parse(line));
}

// 确定性伪随机（mulberry32），让乱序可复现。
function rng(seed) {
  let a = seed >>> 0;
  return () => {
    a |= 0; a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// 模拟投递侧乱序到达。
export function shuffled(events, seed = 42) {
  const arr = events.slice();
  const rand = rng(seed);
  for (let i = arr.length - 1; i > 0; i--) {
    const j = Math.floor(rand() * (i + 1));
    [arr[i], arr[j]] = [arr[j], arr[i]];
  }
  return arr;
}

export function runEngine(events, { maxHoldMs = 10, seed = 42 } = {}) {
  const queue = new OutboxQueue();
  for (const e of events) queue.append(e);

  const buffer = new ReorderBuffer(maxHoldMs);
  const sink = new IdempotentSink();
  const stats = { emitted: 0, stale: 0, late: 0, applied: 0, skipped: 0 };
  const log = [];

  const handle = (actions) => {
    for (const action of actions) {
      if (action.type === 'hold') {
        log.push({ action: 'hold', id: action.event.id, key: action.event.key, version: action.event.version });
        continue;
      }
      if (action.type === 'stale') {
        stats.stale += 1;
        stats.skipped += 1;
        log.push({ action: 'stale', id: action.event.id, key: action.event.key, version: action.event.version });
        continue;
      }
      if (action.type === 'late') stats.late += 1;
      else stats.emitted += 1;
      const r = sink.apply(action.event);
      if (r.applied) stats.applied += 1;
      else stats.skipped += 1;
      log.push({ action: action.type, id: action.event.id, key: action.event.key, version: action.event.version, applied: r.applied, reason: r.reason });
    }
  };

  let now = 0;
  for (const event of shuffled(queue.listAfter(0), seed)) {
    now += 1; // 逻辑时钟：每到达一个事件推进 1ms
    handle(buffer.offer(event, now));
  }
  handle(buffer.flush(now + maxHoldMs + 1)); // 流结束，排空滞留事件

  return { stats, log, sink };
}

// ---- 浏览器 UI 接线（node 测试 import 时不触发）----
if (typeof document !== 'undefined') {
  const $ = (id) => document.getElementById(id);
  const statusEl = $('status');
  const statsEl = $('stats');
  const logEl = $('log');
  const loadBtn = $('load');
  const runBtn = $('run');
  const exportBtn = $('export');

  let events = null;
  let result = null;

  const fail = (err) => { statusEl.textContent = `error: ${err.message}`; };

  loadBtn.addEventListener('click', async () => {
    try {
      statusEl.textContent = 'loading';
      events = await loadEvents();
      statusEl.textContent = 'ready';
      runBtn.disabled = false;
    } catch (err) { fail(err); }
  });

  runBtn.addEventListener('click', () => {
    try {
      result = runEngine(events);
      statsEl.innerHTML = Object.entries(result.stats)
        .map(([k, v]) => `<div class="stat"><span>${k}</span><b id="stat-${k}">${v}</b></div>`)
        .join('');
      logEl.textContent = result.log.map((e) => JSON.stringify(e)).join('\n');
      statusEl.textContent = 'done';
      exportBtn.disabled = false;
    } catch (err) { fail(err); }
  });

  exportBtn.addEventListener('click', () => {
    try {
      const blob = new Blob([JSON.stringify({ stats: result.stats, log: result.log }, null, 2)], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'outbox-run.json';
      a.click();
      URL.revokeObjectURL(a.href);
    } catch (err) { fail(err); }
  });
}
```

