**src/reorderBuffer.js**

```js
// 按 key 维护已提交版本，窗口内缓冲乱序；超时按到达序投递并标记 late。
export class ReorderBuffer {
  constructor(maxHoldMs = 1000) {
    this.maxHoldMs = maxHoldMs;
    this.committed = new Map(); // key -> 已投递的最高 version
    this.pending = new Map();   // key -> [{ event, arrivedAt }]（到达序）
  }

  offer(event, now = Date.now()) {
    const actions = this.flush(now);
    const key = event.key;
    const committed = this.committed.get(key);

    // 不高于已提交版本的到达都是旧版本（含重复投递），记 stale。
    if (committed !== undefined && event.version <= committed) {
      actions.push({ type: 'stale', event });
      return actions;
    }

    // 该 key 首次出现，或恰好是下一个版本：直接提交，并尝试连排放出缓冲。
    if (committed === undefined || event.version === committed + 1) {
      actions.push({ type: 'emit', event });
      this.committed.set(key, event.version);
      actions.push(...this.#drain(key));
      return actions;
    }

    // 版本跳跃：窗口内缓冲，等乱序补齐。
    const buf = this.pending.get(key) ?? [];
    buf.push({ event, arrivedAt: now });
    this.pending.set(key, buf);
    actions.push({ type: 'hold', event });
    return actions;
  }

  // 把滞留超过 maxHoldMs 的事件按到达序放出，标记 late。
  flush(now = Date.now()) {
    const actions = [];
    for (const [key, buf] of this.pending) {
      const keep = [];
      for (const entry of buf) {
        const committed = this.committed.get(key);
        if (committed !== undefined && entry.event.version <= committed) {
          actions.push({ type: 'stale', event: entry.event });
        } else if (now - entry.arrivedAt >= this.maxHoldMs) {
          this.committed.set(key, entry.event.version);
          actions.push({ type: 'late', event: entry.event });
        } else {
          keep.push(entry);
        }
      }
      if (keep.length) this.pending.set(key, keep);
      else this.pending.delete(key);
    }
    return actions;
  }

  // 提交后把缓冲里连续的下一个版本依次放出；落后于已提交版本的记 stale。
  #drain(key) {
    const actions = [];
    let buf = this.pending.get(key) ?? [];
    const keep = [];
    for (const entry of buf) {
      const committed = this.committed.get(key);
      if (entry.event.version <= committed) {
        actions.push({ type: 'stale', event: entry.event });
      } else {
        keep.push(entry);
      }
    }
    buf = keep;
    let progressed = true;
    while (progressed) {
      progressed = false;
      const next = this.committed.get(key) + 1;
      const idx = buf.findIndex((e) => e.event.version === next);
      if (idx !== -1) {
        const [entry] = buf.splice(idx, 1);
        this.committed.set(key, entry.event.version);
        actions.push({ type: 'emit', event: entry.event });
        progressed = true;
      }
    }
    if (buf.length) this.pending.set(key, buf);
    else this.pending.delete(key);
    return actions;
  }
}
